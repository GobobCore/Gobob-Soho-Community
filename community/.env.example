# ─── Gobob SOHO 配置 ───────────────────────────────────────────────
# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 忽略，不要提交。

# ── 数据库 (SOHO 自己的 MySQL) ──
SOHO_MYSQL_HOST=mysql
SOHO_MYSQL_PORT=3306
SOHO_MYSQL_DB=gobob_soho
SOHO_MYSQL_USER=soho
SOHO_MYSQL_PASS=change_me_to_a_strong_password

# MySQL root（仅 docker 初始化用）
MYSQL_ROOT_PASSWORD=change_me_root_password

# ── JWT ──
# 用 `openssl rand -hex 32` 生成
SOHO_JWT_SECRET=change_me_to_64_hex_chars
SOHO_JWT_EXPIRE_HOURS=72

# ── 初始管理员（首次启动时创建，之后请登录修改）──
SOHO_ADMIN_USERNAME=admin
SOHO_ADMIN_PASSWORD=change_me_admin_password
SOHO_ORG_NAME=我的留学工作室

# ── Gobob Data API（智能评估 / 院校数据）──
# 申请方式见 docs/GETTING_GOBOB_API_KEY.md
# 留空则核心业务可用，但智能评估 / 院校数据功能关闭
GOBOB_API_BASE=https://api.gobob.cn
GOBOB_API_KEY=

# ── 端口（可选，默认如下）──
SOHO_BACKEND_PORT=19001
SOHO_PORTAL_PORT=19002
SOHO_APP_PORT=19003
