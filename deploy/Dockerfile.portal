FROM node:20-alpine AS builder
WORKDIR /app
COPY portal/package.json portal/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY portal/ ./
ARG SOHO_BACKEND_URL=http://backend:19001
ENV SOHO_BACKEND_URL=$SOHO_BACKEND_URL
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app ./
EXPOSE 19002
CMD ["npm", "start"]
